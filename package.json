{
  "name": "flexboxjs",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript port of Taffy's CSS flexbox layout algorithm",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gentest": "tsx scripts/gentest.ts",
    "bench": "tsx scripts/bench.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "fast-xml-parser": "^4.4.0",
    "puppeteer": "^25.4.0",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
