<test name="block_percentage_margin_intrinsic_width__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr">
      <div display="block" direction="ltr" width="100px" height="100px">
        <div display="block" direction="ltr" position="absolute">
          <div display="block" direction="ltr" width="100px" height="100px" margin-left="-50%"/>
        </div>
      </div>
      <div display="block" direction="ltr" width="100px" height="100px">
        <div display="block" direction="ltr" position="absolute">
          <div display="block" direction="ltr" width="100px" height="100px" margin-left="50%"/>
        </div>
      </div>
      <div display="block" direction="ltr" width="100px" height="100px">
        <div display="block" direction="ltr" position="absolute">
          <div display="block" direction="ltr" width="100px" height="100px" margin-left="-50px"/>
        </div>
      </div>
      <div display="block" direction="ltr" width="100px" height="100px">
        <div display="block" direction="ltr" position="absolute">
          <div display="block" direction="ltr" width="100px" height="100px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="400">
      <node x="0" y="0" width="100" height="100">
        <node x="0" y="0" width="100" height="100">
          <node x="-50" y="0" width="100" height="100"/>
        </node>
      </node>
      <node x="0" y="100" width="100" height="100">
        <node x="0" y="0" width="100" height="100">
          <node x="50" y="0" width="100" height="100"/>
        </node>
      </node>
      <node x="0" y="200" width="100" height="100">
        <node x="0" y="0" width="50" height="100">
          <node x="-50" y="0" width="100" height="100"/>
        </node>
      </node>
      <node x="0" y="300" width="100" height="100">
        <node x="0" y="0" width="100" height="100">
          <node x="0" y="0" width="100" height="100"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
