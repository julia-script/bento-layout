<test name="flex_cross_auto_margin_negative_space__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="rtl">
      <div display="flex" direction="rtl" width="55px" height="1px">
        <div display="block" direction="rtl" margin-top="auto" margin-left="3px" margin-bottom="17px"/>
      </div>
      <div display="flex" direction="rtl" width="55px" height="1px">
        <div display="block" direction="rtl" margin-top="auto" margin-left="3px" margin-bottom="40%"/>
      </div>
      <div display="flex" direction="rtl" width="55px" height="1px">
        <div display="block" direction="rtl" margin-top="auto" margin-left="3px" margin-bottom="0px"/>
      </div>
      <div display="flex" direction="rtl" width="55px" height="1px">
        <div display="block" direction="rtl" margin-top="0px" margin-left="3px" margin-bottom="17px"/>
      </div>
      <div display="flex" direction="rtl" width="55px" height="1px">
        <div display="block" direction="rtl" margin-top="auto" margin-left="3px" margin-bottom="auto"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="55" height="5">
      <node x="0" y="0" width="55" height="1">
        <node x="55" y="0" width="0" height="0"/>
      </node>
      <node x="0" y="1" width="55" height="1">
        <node x="55" y="0" width="0" height="0"/>
      </node>
      <node x="0" y="2" width="55" height="1">
        <node x="55" y="1" width="0" height="0"/>
      </node>
      <node x="0" y="3" width="55" height="1">
        <node x="55" y="0" width="0" height="0"/>
      </node>
      <node x="0" y="4" width="55" height="1">
        <node x="55" y="1" width="0" height="0"/>
      </node>
    </node>
  </expectations>
</test>
