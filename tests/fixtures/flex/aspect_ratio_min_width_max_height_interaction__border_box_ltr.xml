<test name="aspect_ratio_min_width_max_height_interaction__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" direction="ltr" align-items="flex-start" width="300px" height="200px">
      <div direction="ltr" flex-grow="1" min-width="120px" max-height="50px" aspect-ratio="2"/>
      <div direction="ltr" width="60px" max-height="90px" aspect-ratio="0.5"/>
      <div direction="ltr" flex-grow="1" flex-basis="0px" min-width="40px" aspect-ratio="1"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="200">
      <node x="0" y="0" width="120" height="50"/>
      <node x="120" y="0" width="60" height="90"/>
      <node x="180" y="0" width="120" height="120"/>
    </node>
  </expectations>
</test>
