<test name="align_baseline_text_vs_synthesized__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" align-items="flex-start">
      <div box-sizing="content-box" direction="rtl" align-items="baseline">
        <text box-sizing="content-box" direction="rtl">
          HHHH
        </text>
        <div box-sizing="content-box" direction="rtl" width="5px" height="5px"/>
      </div>
      <div box-sizing="content-box" direction="rtl" align-items="baseline">
        <text box-sizing="content-box" direction="rtl">
          HHHH
        </text>
        <div box-sizing="content-box" direction="rtl" width="5px" height="5px" margin-top="3px"/>
      </div>
      <div box-sizing="content-box" direction="rtl" align-items="baseline">
        <text box-sizing="content-box" direction="rtl">
          HHHH
        </text>
        <div box-sizing="content-box" direction="rtl" width="5px" height="5px" margin-top="6px"/>
      </div>
      <div box-sizing="content-box" direction="rtl" align-items="baseline">
        <text box-sizing="content-box" direction="rtl">
          HHHH
        </text>
        <div box-sizing="content-box" direction="rtl" width="5px" height="5px" border-top="2px"/>
      </div>
      <div box-sizing="content-box" direction="rtl" align-items="baseline">
        <text box-sizing="content-box" direction="rtl">
          HHHH
        </text>
        <div box-sizing="content-box" direction="rtl" width="5px" height="20px"/>
      </div>
      <div box-sizing="content-box" direction="rtl" align-items="baseline">
        <text box-sizing="content-box" direction="rtl">
          HHHH
        </text>
        <text box-sizing="content-box" direction="rtl" padding-top="4px">
          H
        </text>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="50" height="79">
      <node x="5" y="0" width="45" height="10">
        <node x="5" y="0" width="40" height="10"/>
        <node x="0" y="3" width="5" height="5"/>
      </node>
      <node x="5" y="10" width="45" height="10">
        <node x="5" y="0" width="40" height="10"/>
        <node x="0" y="3" width="5" height="5"/>
      </node>
      <node x="5" y="20" width="45" height="13">
        <node x="5" y="3" width="40" height="10"/>
        <node x="0" y="6" width="5" height="5"/>
      </node>
      <node x="5" y="33" width="45" height="10">
        <node x="5" y="0" width="40" height="10"/>
        <node x="0" y="1" width="5" height="7"/>
      </node>
      <node x="5" y="43" width="45" height="22">
        <node x="5" y="12" width="40" height="10"/>
        <node x="0" y="0" width="5" height="20"/>
      </node>
      <node x="0" y="65" width="50" height="14">
        <node x="10" y="4" width="40" height="10"/>
        <node x="0" y="0" width="10" height="14"/>
      </node>
    </node>
  </expectations>
</test>
