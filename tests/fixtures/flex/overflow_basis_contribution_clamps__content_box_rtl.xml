<test name="overflow_basis_contribution_clamps__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" align-items="flex-start">
      <div box-sizing="content-box" direction="rtl">
        <div box-sizing="content-box" direction="rtl" overflow-x="hidden" scrollbar-width="0" flex-basis="20px" height="5px"/>
      </div>
      <div box-sizing="content-box" direction="rtl">
        <div box-sizing="content-box" direction="rtl" overflow-x="hidden" scrollbar-width="0" flex-shrink="0" flex-basis="20px" height="5px"/>
      </div>
      <div box-sizing="content-box" direction="rtl">
        <text box-sizing="content-box" direction="rtl" overflow-x="hidden" scrollbar-width="0" flex-basis="20px" height="5px">
          HHHH
        </text>
      </div>
      <div box-sizing="content-box" direction="rtl">
        <text box-sizing="content-box" direction="rtl" flex-basis="20px" height="5px">
          HHHH
        </text>
      </div>
      <div box-sizing="content-box" direction="rtl">
        <text box-sizing="content-box" direction="rtl" overflow-x="hidden" scrollbar-width="0" flex-grow="1" flex-basis="20px" height="5px">
          HHHH
        </text>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="40" height="25">
      <node x="40" y="0" width="0" height="5">
        <node x="0" y="0" width="0" height="5" scroll_width="0" scroll_height="0"/>
      </node>
      <node x="20" y="5" width="20" height="5">
        <node x="0" y="0" width="20" height="5" scroll_width="0" scroll_height="0"/>
      </node>
      <node x="20" y="10" width="20" height="5">
        <node x="0" y="0" width="20" height="5" scroll_width="20" scroll_height="5"/>
      </node>
      <node x="0" y="15" width="40" height="5">
        <node x="0" y="0" width="40" height="5"/>
      </node>
      <node x="0" y="20" width="40" height="5">
        <node x="0" y="0" width="40" height="5" scroll_width="0" scroll_height="5"/>
      </node>
    </node>
  </expectations>
</test>
