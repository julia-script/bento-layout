      <node x="0" y="10" width="45" height="10">
        <node x="0" y="0" width="40" height="10"/>
        <node x="40" y="3" width="5" height="5"/>
      </node>
      <node x="0" y="20" width="45" height="13">
        <node x="0" y="3" width="40" height="10"/>
        <node x="40" y="6" width="5" height="5"/>
      </node>
      <node x="0" y="33" width="45" height="10">
        <node x="0" y="0" width="40" height="10"/>
        <node x="40" y="3" width="5" height="5"/>
      </node>
      <node x="0" y="43" width="45" height="22">
        <node x="0" y="12" width="40" height="10"/>
        <node x="40" y="0" width="5" height="20"/>
      </node>
      <node x="0" y="65" width="50" height="14">
        <node x="0" y="4" width="40" height="10"/>
        <node x="40" y="0" width="10" height="14"/>
      </node>
    </node>
