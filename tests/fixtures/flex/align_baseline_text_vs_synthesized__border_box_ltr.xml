<test name="align_baseline_text_vs_synthesized__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="ltr" position="absolute" flex-direction="column" align-items="flex-start">
      <div direction="ltr" align-items="baseline">
        <text direction="ltr">
          HHHH
        </text>
        <div direction="ltr" width="5px" height="5px"/>
      </div>
      <div direction="ltr" align-items="baseline">
        <text direction="ltr">
          HHHH
        </text>
        <div direction="ltr" width="5px" height="5px" margin-top="3px"/>
      </div>
      <div direction="ltr" align-items="baseline">
        <text direction="ltr">
          HHHH
        </text>
        <div direction="ltr" width="5px" height="5px" margin-top="6px"/>
      </div>
      <div direction="ltr" align-items="baseline">
        <text direction="ltr">
          HHHH
        </text>
        <div direction="ltr" width="5px" height="5px" border-top="2px"/>
      </div>
      <div direction="ltr" align-items="baseline">
        <text direction="ltr">
          HHHH
        </text>
        <div direction="ltr" width="5px" height="20px"/>
      </div>
      <div direction="ltr" align-items="baseline">
        <text direction="ltr">
          HHHH
        </text>
        <text direction="ltr" padding-top="4px">
          H
        </text>
      </div>
    </div>
  </input>
  <expectations>
