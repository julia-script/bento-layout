<test name="flex_aspect_ratio_from_known_width__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr" position="absolute">
      <div display="block" direction="ltr" width="200px">
        <div display="flex" direction="ltr" aspect-ratio="4"/>
      </div>
      <div display="block" direction="ltr" width="200px">
        <div display="flex" direction="ltr" aspect-ratio="4">
          <div display="flex" direction="ltr"/>
        </div>
      </div>
      <div display="block" direction="ltr" width="200px">
        <div display="flex" direction="ltr" aspect-ratio="4">
          <div display="block" direction="ltr" aspect-ratio="1"/>
        </div>
      </div>
      <div display="block" direction="ltr" width="200px">
        <div display="flex" direction="ltr">
          <div display="flex" direction="ltr" aspect-ratio="1"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="150">
      <node x="0" y="0" width="200" height="50">
        <node x="0" y="0" width="200" height="50"/>
      </node>
      <node x="0" y="50" width="200" height="50">
        <node x="0" y="0" width="200" height="50">
          <node x="0" y="0" width="0" height="50"/>
        </node>
      </node>
      <node x="0" y="100" width="200" height="50">
        <node x="0" y="0" width="200" height="50">
          <node x="0" y="0" width="50" height="50"/>
        </node>
      </node>
      <node x="0" y="150" width="200" height="0">
        <node x="0" y="0" width="200" height="0">
          <node x="0" y="0" width="0" height="0"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
