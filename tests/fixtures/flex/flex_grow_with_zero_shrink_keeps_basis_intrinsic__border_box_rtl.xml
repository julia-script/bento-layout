<test name="flex_grow_with_zero_shrink_keeps_basis_intrinsic__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="rtl" position="absolute" flex-direction="column" align-items="start">
      <div direction="rtl">
        <div direction="rtl" flex-grow="1" flex-shrink="0" flex-basis="320px" height="10px"/>
      </div>
      <div direction="rtl">
        <div direction="rtl" flex-grow="3" flex-shrink="0" flex-basis="10px" height="10px"/>
      </div>
      <div direction="rtl">
        <div direction="rtl" flex-grow="1" flex-basis="320px" height="10px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="320" height="30">
      <node x="0" y="0" width="320" height="10">
        <node x="0" y="0" width="320" height="10"/>
      </node>
      <node x="310" y="10" width="10" height="10">
        <node x="0" y="0" width="10" height="10"/>
      </node>
      <node x="320" y="20" width="0" height="10">
        <node x="0" y="0" width="0" height="10"/>
      </node>
    </node>
  </expectations>
</test>
