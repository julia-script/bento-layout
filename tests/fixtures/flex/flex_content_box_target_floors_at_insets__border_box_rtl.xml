<test name="flex_content_box_target_floors_at_insets__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="rtl" position="absolute" justify-content="center" max-width="10px" max-height="120px">
      <div direction="rtl" overflow-x="hidden" overflow-y="scroll" scrollbar-width="0" width="40px" border-top="3px" border-left="120px" border-bottom="7px" border-right="10px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="10" height="10">
      <node x="-60" y="0" width="130" height="10" scroll_width="0" scroll_height="0"/>
    </node>
  </expectations>
</test>
