<test name="grid_aspect_ratio_transfers_automatic_minimum__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="rtl" position="absolute" grid-auto-columns="1px">
      <div direction="rtl" aspect-ratio="0.5" border-top="97px" border-left="97px" border-right="1px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1" height="196">
      <node x="-97" y="0" width="98" height="196"/>
    </node>
  </expectations>
</test>
