  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="ltr" position="absolute" grid-template-rows="60% auto minmax(1px,1fr)">
      <text box-sizing="content-box" direction="ltr" grid-row-start="span 2">
        HHHHHHH
      </text>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="70" height="11">
      <node x="0" y="0" width="70" height="10"/>
    </node>
  </expectations>
</test>
