<test name="grid_aspect_ratio_transfers_automatic_minimum__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="ltr" position="absolute" grid-auto-columns="1px">
      <div box-sizing="content-box" direction="ltr" aspect-ratio="0.5" border-top="97px" border-left="97px" border-right="1px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1" height="97">
      <node x="0" y="0" width="98" height="97"/>
    </node>
  </expectations>
</test>
