<test name="grid_abspos_start_line_includes_aligned_gutter__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="rtl" position="absolute" justify-content="space-between" width="100px" height="20px" column-gap="5px" grid-template-columns="20px 20px">
      <div direction="rtl" position="absolute" grid-column-start="2" grid-column-end="3"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="20">
      <node x="20" y="0" width="0" height="0"/>
    </node>
  </expectations>
</test>
