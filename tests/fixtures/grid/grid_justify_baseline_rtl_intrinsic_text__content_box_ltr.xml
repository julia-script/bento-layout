<test name="grid_justify_baseline_rtl_intrinsic_text__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="ltr" position="absolute">
      <text box-sizing="content-box" direction="ltr" position="static" justify-self="baseline">
        HHH​HHH​HHHHH​HHH
      </text>
      <text box-sizing="content-box" direction="ltr" position="static" justify-self="baseline">
        HH
      </text>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="140" height="20">
      <node x="0" y="0" width="140" height="10"/>
      <node x="0" y="10" width="20" height="10"/>
    </node>
  </expectations>
</test>
