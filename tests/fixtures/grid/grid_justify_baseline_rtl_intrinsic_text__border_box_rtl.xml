<test name="grid_justify_baseline_rtl_intrinsic_text__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="rtl" position="absolute">
      <text direction="rtl" position="static" justify-self="baseline">
        HHH​HHH​HHHHH​HHH
      </text>
      <text direction="rtl" position="static" justify-self="baseline">
        HH
      </text>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="50" height="50">
      <node x="0" y="0" width="50" height="40"/>
      <node x="0" y="40" width="20" height="10"/>
    </node>
  </expectations>
</test>
