<test name="grid_span_2_zero_contribution_all_spanned_tracks__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="ltr" position="absolute" grid-template-columns="auto auto">
      <div box-sizing="content-box" direction="ltr" width="20px" height="10px" grid-column-start="1" grid-column-end="span 2"/>
      <div box-sizing="content-box" direction="ltr" grid-column-start="1"/>
      <div box-sizing="content-box" direction="ltr" grid-column-start="2"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="20" height="10">
      <node x="0" y="0" width="20" height="10"/>
      <node x="0" y="10" width="10" height="0"/>
      <node x="10" y="10" width="10" height="0"/>
    </node>
  </expectations>
</test>
