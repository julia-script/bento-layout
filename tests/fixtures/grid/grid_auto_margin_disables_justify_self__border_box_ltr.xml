<test name="grid_auto_margin_disables_justify_self__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="ltr" position="absolute" grid-template-columns="3px 300px">
      <div direction="ltr" justify-self="center" width="0px" height="10px" margin-left="auto" margin-right="120px" grid-column-start="1"/>
      <div direction="ltr" justify-self="center" width="0px" height="10px" margin-left="auto" margin-right="20px" grid-column-start="2"/>
      <div direction="ltr" justify-self="center" width="0px" height="10px" margin-left="10px" margin-right="120px" grid-column-start="1"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="303" height="20">
      <node x="0" y="0" width="0" height="10"/>
      <node x="283" y="0" width="0" height="10"/>
      <node x="-53" y="10" width="0" height="10"/>
    </node>
  </expectations>
</test>
