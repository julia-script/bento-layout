<test name="grid_abspos_rtl_i_ltr__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="ltr" width="500px" height="130px" padding-top="10px" padding-left="10px" padding-bottom="10px" padding-right="10px">
      <div display="block" box-sizing="content-box" direction="ltr" position="absolute" width="100%" height="100%" grid-row-start="1" grid-row-end="2" grid-column-start="-3" grid-column-end="span 6"/>
      <div display="block" box-sizing="content-box" direction="ltr" grid-column-start="-5" grid-column-end="span 8"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="520" height="150">
      <node x="135" y="10" width="375" height="130"/>
      <node x="10" y="10" width="500" height="130"/>
    </node>
  </expectations>
</test>
