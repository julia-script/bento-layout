<test name="fuzz_grid_auto_min_ignores_unspanned_fr__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="rtl" position="absolute" width="10px" height="20px" grid-template-rows="60% auto minmax(1px,1fr)">
      <text box-sizing="content-box" direction="rtl" grid-row-start="span 2">
        H​H​HHHHH
      </text>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="10" height="20">
      <node x="-40" y="0" width="50" height="20"/>
    </node>
  </expectations>
</test>
