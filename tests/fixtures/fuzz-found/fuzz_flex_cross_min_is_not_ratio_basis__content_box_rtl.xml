<test name="fuzz_flex_cross_min_is_not_ratio_basis__content_box_rtl" use-rounding="true">
  <viewport width="1280px" height="800px"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute">
      <div box-sizing="content-box" direction="rtl" min-height="0px" aspect-ratio="1">
        <div display="grid" box-sizing="content-box" direction="rtl" grid-template-columns="minmax(auto,1px)"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1" height="1">
      <node x="0" y="0" width="1" height="1">
        <node x="0" y="0" width="1" height="1"/>
      </node>
    </node>
  </expectations>
</test>
