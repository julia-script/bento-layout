<test name="fuzz_grid_ratio_uses_used_border_box_contribution__content_box_ltr" use-rounding="true">
  <viewport width="1280px" height="800px"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="ltr" position="absolute" width="0px">
      <div display="grid" box-sizing="content-box" direction="ltr">
        <div box-sizing="content-box" direction="ltr" height="0px" aspect-ratio="1" border-bottom="1px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="0" height="1">
      <node x="0" y="0" width="0" height="1">
        <node x="0" y="0" width="0" height="1"/>
      </node>
    </node>
  </expectations>
</test>
