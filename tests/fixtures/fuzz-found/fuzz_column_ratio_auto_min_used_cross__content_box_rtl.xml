<test name="fuzz_column_ratio_auto_min_used_cross__content_box_rtl" use-rounding="true">
  <viewport width="1280px" height="800px"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" width="0px">
      <div box-sizing="content-box" direction="rtl" aspect-ratio="1">
        <div box-sizing="content-box" direction="rtl" padding-right="1px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="0" height="0">
      <node x="0" y="0" width="0" height="0">
        <node x="-1" y="0" width="1" height="0"/>
      </node>
    </node>
  </expectations>
</test>
