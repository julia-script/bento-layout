<test name="fuzz_grid_auto_max_content_flex_bases__content_box_rtl" use-rounding="true">
  <viewport width="1280px" height="800px"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="rtl" position="absolute">
      <div display="grid" box-sizing="content-box" direction="rtl" grid-template-columns="repeat(3, minmax(auto,1fr))">
        <div box-sizing="content-box" direction="rtl" grid-column-start="span 3">
          <div box-sizing="content-box" direction="rtl" border-right="3px"/>
        </div>
        <div box-sizing="content-box" direction="rtl" margin-right="1px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="3" height="0">
      <node x="0" y="0" width="3" height="0">
        <node x="0" y="0" width="3" height="0">
          <node x="0" y="0" width="3" height="0"/>
        </node>
        <node x="2" y="0" width="0" height="0"/>
      </node>
    </node>
  </expectations>
</test>
