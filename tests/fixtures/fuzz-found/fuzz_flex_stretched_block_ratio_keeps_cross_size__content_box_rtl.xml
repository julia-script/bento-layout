<test name="fuzz_flex_stretched_block_ratio_keeps_cross_size__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute" width="0px" height="320px">
      <div display="block" box-sizing="content-box" direction="rtl" aspect-ratio="1.5">
        <div display="block" box-sizing="content-box" direction="rtl">
          <div box-sizing="content-box" direction="rtl" aspect-ratio="0.5"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="0" height="320">
      <node x="-480" y="0" width="480" height="320">
        <node x="0" y="0" width="480" height="960">
          <node x="0" y="0" width="480" height="960"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
