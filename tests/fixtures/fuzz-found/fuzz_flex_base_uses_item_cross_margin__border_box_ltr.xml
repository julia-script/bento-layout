<test name="fuzz_flex_base_uses_item_cross_margin__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" direction="ltr" position="absolute" width="0px" height="0px">
      <div direction="ltr" overflow-y="hidden" scrollbar-width="0" min-height="1px" aspect-ratio="1" margin-bottom="1px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="0" height="0">
      <node x="0" y="0" width="0" height="1" scroll_width="0" scroll_height="0"/>
    </node>
  </expectations>
</test>
