<test name="fuzz_grid_ratio_clamps_stretched_inline_source__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="ltr" position="absolute">
      <div display="grid" box-sizing="content-box" direction="ltr" grid-template-columns="repeat(auto-fill, 3px)">
        <div box-sizing="content-box" direction="ltr" max-width="1px" max-height="20px" aspect-ratio="1.5"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="3" height="1">
      <node x="0" y="0" width="3" height="1">
        <node x="0" y="0" width="1" height="1"/>
      </node>
    </node>
  </expectations>
</test>
