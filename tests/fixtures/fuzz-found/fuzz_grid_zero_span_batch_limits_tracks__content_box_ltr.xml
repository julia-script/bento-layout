<test name="fuzz_grid_zero_span_batch_limits_tracks__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="ltr" position="absolute">
      <div box-sizing="content-box" direction="ltr" grid-row-start="span 2" grid-row-end="2"/>
      <div box-sizing="content-box" direction="ltr" padding-bottom="1px" grid-row-end="span 3" grid-column-end="3"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="0" height="1">
      <node x="0" y="0" width="0" height="0"/>
      <node x="0" y="0" width="0" height="1"/>
    </node>
  </expectations>
</test>
