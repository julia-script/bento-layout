<test name="fuzz_grid_cyclic_synthesized_baseline__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="ltr" position="absolute" width="34px" height="0px">
      <div display="grid" box-sizing="content-box" direction="ltr" align-items="baseline" width="17px" height="0px" min-height="0px" grid-template-columns="max-content fit-content(1%)">
        <div box-sizing="content-box" direction="ltr" height="320px"/>
        <div box-sizing="content-box" direction="ltr" width="1px" height="100%"/>
      </div>
      <div display="grid" box-sizing="content-box" direction="ltr" align-items="baseline" width="17px" height="0px" min-height="0px" grid-template-rows="320px" grid-template-columns="max-content fit-content(1%)">
        <div box-sizing="content-box" direction="ltr" height="320px"/>
        <div box-sizing="content-box" direction="ltr" width="1px" height="50%"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="34" height="0">
      <node x="0" y="0" width="17" height="0">
        <node x="0" y="0" width="0" height="320"/>
        <node x="0" y="0" width="1" height="320"/>
      </node>
      <node x="17" y="0" width="17" height="0">
        <node x="0" y="0" width="0" height="320"/>
        <node x="0" y="160" width="1" height="160"/>
      </node>
    </node>
  </expectations>
</test>
