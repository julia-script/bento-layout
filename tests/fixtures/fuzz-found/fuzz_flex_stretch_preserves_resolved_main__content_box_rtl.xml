<test name="fuzz_flex_stretch_preserves_resolved_main__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute" align-items="start">
      <div box-sizing="content-box" direction="rtl">
        <div box-sizing="content-box" direction="rtl" aspect-ratio="1"/>
        <text box-sizing="content-box" direction="rtl">
          H
        </text>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="10" height="10">
      <node x="0" y="0" width="10" height="10">
        <node x="10" y="0" width="0" height="10"/>
        <node x="0" y="0" width="10" height="10"/>
      </node>
    </node>
  </expectations>
</test>
