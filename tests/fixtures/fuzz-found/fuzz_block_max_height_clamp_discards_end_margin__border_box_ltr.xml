  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr" position="absolute" width="10px" height="7px" border-top="10px">
      <div display="block" direction="ltr" max-height="50%">
        <div direction="ltr" min-height="3px" margin-top="97px" margin-bottom="120px"/>
      </div>
      <div direction="ltr"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="10" height="10">
      <node x="0" y="107" width="10" height="0">
        <node x="0" y="0" width="10" height="3"/>
      </node>
      <node x="0" y="107" width="10" height="0"/>
    </node>
  </expectations>
</test>
