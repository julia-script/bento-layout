<test name="fuzz_flex_shrink_to_fit_basis__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="rtl" position="absolute">
      <div display="grid" direction="rtl" justify-items="start">
        <div display="flex" direction="rtl">
          <div direction="rtl" flex-basis="55px"/>
        </div>
      </div>
      <div display="grid" direction="rtl" justify-items="start">
        <div display="flex" direction="rtl">
          <div direction="rtl" flex-shrink="0" flex-basis="55px"/>
        </div>
      </div>
      <div display="grid" direction="rtl" justify-items="start">
        <div display="flex" direction="rtl">
          <div direction="rtl" width="55px"/>
        </div>
      </div>
      <div display="grid" direction="rtl" justify-items="start">
        <div display="flex" direction="rtl">
          <div direction="rtl" flex-basis="10px" width="55px"/>
        </div>
      </div>
      <div display="grid" direction="rtl" justify-items="start">
        <div display="flex" direction="rtl">
          <div direction="rtl" width="200px" height="120px" max-width="1px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="55" height="120">
      <node x="0" y="0" width="55" height="0">
        <node x="55" y="0" width="0" height="0">
          <node x="0" y="0" width="0" height="0"/>
        </node>
      </node>
      <node x="0" y="0" width="55" height="0">
        <node x="0" y="0" width="55" height="0">
          <node x="0" y="0" width="55" height="0"/>
        </node>
      </node>
      <node x="0" y="0" width="55" height="0">
        <node x="0" y="0" width="55" height="0">
          <node x="0" y="0" width="55" height="0"/>
        </node>
      </node>
      <node x="0" y="0" width="55" height="0">
        <node x="45" y="0" width="10" height="0">
          <node x="0" y="0" width="10" height="0"/>
        </node>
      </node>
      <node x="0" y="0" width="55" height="120">
        <node x="54" y="0" width="1" height="120">
          <node x="0" y="0" width="1" height="120"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
