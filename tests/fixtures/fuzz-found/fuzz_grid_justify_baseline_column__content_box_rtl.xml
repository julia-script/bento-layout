<test name="fuzz_grid_justify_baseline_column__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" position="absolute">
      <div display="grid" box-sizing="content-box" direction="rtl" justify-items="baseline" grid-template-columns="100px">
        <div box-sizing="content-box" direction="rtl" width="30px" height="40px"/>
        <div box-sizing="content-box" direction="rtl" width="20px" height="20px"/>
      </div>
      <div display="grid" box-sizing="content-box" direction="rtl" justify-items="baseline" grid-template-columns="100px">
        <div box-sizing="content-box" direction="rtl" width="30px" height="40px" margin-left="5px"/>
        <div box-sizing="content-box" direction="rtl" width="20px" height="20px" margin-left="15px"/>
      </div>
      <div display="grid" box-sizing="content-box" direction="rtl" grid-template-columns="100px">
        <div box-sizing="content-box" direction="rtl" justify-self="baseline" width="30px" height="40px"/>
        <div box-sizing="content-box" direction="rtl" justify-self="baseline" width="20px" height="20px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="180">
      <node x="0" y="0" width="100" height="60">
        <node x="70" y="0" width="30" height="40"/>
        <node x="70" y="40" width="20" height="20"/>
      </node>
      <node x="0" y="60" width="100" height="60">
        <node x="70" y="0" width="30" height="40"/>
        <node x="70" y="40" width="20" height="20"/>
      </node>
      <node x="0" y="120" width="100" height="60">
        <node x="70" y="0" width="30" height="40"/>
        <node x="70" y="40" width="20" height="20"/>
      </node>
    </node>
  </expectations>
</test>
