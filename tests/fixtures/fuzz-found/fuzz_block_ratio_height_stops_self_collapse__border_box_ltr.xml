<test name="fuzz_block_ratio_height_stops_self_collapse__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr" position="absolute" width="137px">
      <div display="block" direction="ltr" aspect-ratio="1">
        <div direction="ltr" position="absolute"/>
      </div>
      <div display="block" direction="ltr" height="40px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="137" height="177">
      <node x="0" y="0" width="137" height="137">
        <node x="0" y="0" width="0" height="0"/>
      </node>
      <node x="0" y="137" width="137" height="40"/>
    </node>
  </expectations>
</test>
