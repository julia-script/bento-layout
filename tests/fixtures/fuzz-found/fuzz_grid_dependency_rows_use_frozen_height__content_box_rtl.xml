<test name="fuzz_grid_dependency_rows_use_frozen_height__content_box_rtl" use-rounding="true">
  <viewport width="1280px" height="800px"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="rtl" position="absolute" width="0px">
      <div box-sizing="content-box" direction="rtl" min-height="0px" aspect-ratio="1" padding-left="100%" padding-right="1px"/>
      <div box-sizing="content-box" direction="rtl"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="0" height="0">
      <node x="-2" y="0" width="2" height="0"/>
      <node x="-1" y="0" width="1" height="0"/>
    </node>
  </expectations>
</test>
