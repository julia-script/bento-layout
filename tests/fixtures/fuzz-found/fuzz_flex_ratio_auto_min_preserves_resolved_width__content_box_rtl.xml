<test name="fuzz_flex_ratio_auto_min_preserves_resolved_width__content_box_rtl" use-rounding="true">
  <viewport width="1280px" height="800px"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" flex-wrap="wrap" height="0px" aspect-ratio="1">
      <div box-sizing="content-box" direction="rtl" width="1px" height="1px"/>
      <div box-sizing="content-box" direction="rtl" width="1px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1" height="0">
      <node x="0" y="0" width="1" height="0"/>
      <node x="-1" y="0" width="1" height="0"/>
    </node>
  </expectations>
</test>
