<test name="fuzz_grid_inline_baseline_group_rtl__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr" position="absolute">
      <div display="grid" box-sizing="content-box" direction="ltr" justify-items="baseline" width="200px">
        <div box-sizing="content-box" direction="ltr" width="20px" height="10px"/>
        <div box-sizing="content-box" direction="ltr" width="60px" height="10px"/>
      </div>
      <div display="grid" box-sizing="content-box" direction="ltr" justify-items="baseline" width="200px">
        <div box-sizing="content-box" direction="ltr" width="20px" height="10px" margin-right="50px"/>
        <div box-sizing="content-box" direction="ltr" width="60px" height="10px"/>
      </div>
      <div display="grid" box-sizing="content-box" direction="ltr" justify-items="baseline" width="200px" grid-template-columns="100px 100px">
        <div box-sizing="content-box" direction="ltr" width="20px" height="10px" grid-column-start="1" grid-column-end="3"/>
        <div box-sizing="content-box" direction="ltr" width="60px" height="10px" grid-column-start="1" grid-column-end="2"/>
      </div>
      <div display="grid" box-sizing="content-box" direction="ltr" justify-items="baseline" width="200px" grid-template-columns="100px 100px">
        <div box-sizing="content-box" direction="ltr" width="20px" height="10px" grid-column-start="1" grid-column-end="3"/>
        <div box-sizing="content-box" direction="ltr" width="60px" height="10px" grid-column-start="2" grid-column-end="3"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="80">
      <node x="0" y="0" width="200" height="20">
        <node x="0" y="0" width="20" height="10"/>
        <node x="0" y="10" width="60" height="10"/>
      </node>
      <node x="0" y="20" width="200" height="20">
        <node x="0" y="0" width="20" height="10"/>
        <node x="0" y="10" width="60" height="10"/>
      </node>
      <node x="0" y="40" width="200" height="20">
        <node x="0" y="0" width="20" height="10"/>
        <node x="0" y="10" width="60" height="10"/>
      </node>
      <node x="0" y="60" width="200" height="20">
        <node x="0" y="0" width="20" height="10"/>
        <node x="100" y="10" width="60" height="10"/>
      </node>
    </node>
  </expectations>
</test>
