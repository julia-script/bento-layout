<test name="fuzz_flex_ratio_auto_min_preserves_resolved_width__border_box_ltr" use-rounding="true">
  <viewport width="1280px" height="800px"/>
  <input>
    <div direction="ltr" position="absolute" flex-direction="column" flex-wrap="wrap" height="0px" aspect-ratio="1">
      <div direction="ltr" width="1px" height="1px"/>
      <div direction="ltr" width="1px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1" height="0">
      <node x="0" y="0" width="1" height="0"/>
      <node x="1" y="0" width="1" height="0"/>
    </node>
  </expectations>
</test>
