<test name="fuzz_wrap_mincontent_shrinkable_basis__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="ltr" position="absolute">
      <div box-sizing="content-box" direction="ltr" flex-wrap="wrap">
        <div box-sizing="content-box" direction="ltr" flex-basis="10px"/>
      </div>
      <div box-sizing="content-box" direction="ltr" flex-wrap="wrap">
        <div box-sizing="content-box" direction="ltr" flex-shrink="0" flex-basis="10px"/>
      </div>
      <div box-sizing="content-box" direction="ltr" flex-wrap="wrap">
        <div box-sizing="content-box" direction="ltr" flex-basis="10px" min-width="5px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="15" height="0">
      <node x="0" y="0" width="0" height="0">
        <node x="0" y="0" width="0" height="0"/>
      </node>
      <node x="0" y="0" width="10" height="0">
        <node x="0" y="0" width="10" height="0"/>
      </node>
      <node x="10" y="0" width="5" height="0">
        <node x="0" y="0" width="5" height="0"/>
      </node>
    </node>
  </expectations>
</test>
