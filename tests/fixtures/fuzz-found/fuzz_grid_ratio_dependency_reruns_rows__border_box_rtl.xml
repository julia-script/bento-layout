<test name="fuzz_grid_ratio_dependency_reruns_rows__border_box_rtl" use-rounding="true">
  <viewport width="1280px" height="800px"/>
  <input>
    <div direction="rtl" position="absolute" height="12px">
      <div display="grid" direction="rtl">
        <div direction="rtl" aspect-ratio="1"/>
        <div direction="rtl"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="6" height="12">
      <node x="0" y="0" width="6" height="12">
        <node x="-3" y="0" width="9" height="9"/>
        <node x="-3" y="11" width="9" height="1"/>
      </node>
    </node>
  </expectations>
</test>
