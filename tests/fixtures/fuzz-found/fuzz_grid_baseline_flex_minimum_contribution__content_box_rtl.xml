<test name="fuzz_grid_baseline_flex_minimum_contribution__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="rtl" position="absolute" align-items="baseline" grid-template-rows="minmax(auto,0.5fr)">
      <div box-sizing="content-box" direction="rtl" height="200px" grid-row-start="1" grid-row-end="2" grid-column-start="2" grid-column-end="3"/>
      <div box-sizing="content-box" direction="rtl" margin-bottom="97px" grid-row-start="1" grid-row-end="3" grid-column-start="1" grid-column-end="2"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="0" height="200">
      <node x="0" y="0" width="0" height="200"/>
      <node x="0" y="200" width="0" height="0"/>
    </node>
  </expectations>
</test>
