<test name="fuzz_flex_nested_preferred_width_intrinsic_contribution__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="ltr" position="absolute" width="1px" height="200px">
      <div display="flex" box-sizing="content-box" direction="ltr">
        <div box-sizing="content-box" direction="ltr" flex-grow="2" width="20px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1" height="200">
      <node x="0" y="0" width="20" height="200">
        <node x="0" y="0" width="20" height="200"/>
      </node>
    </node>
  </expectations>
</test>
