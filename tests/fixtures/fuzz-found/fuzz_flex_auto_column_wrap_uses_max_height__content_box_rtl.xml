<test name="fuzz_flex_auto_column_wrap_uses_max_height__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute" width="320px" height="97px">
      <div box-sizing="content-box" direction="rtl" flex-direction="column" flex-wrap="wrap" align-self="end" row-gap="40px" margin-top="200px" margin-left="200px" margin-bottom="20px" margin-right="10px">
        <div box-sizing="content-box" direction="rtl"/>
        <div box-sizing="content-box" direction="rtl"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="320" height="97">
      <node x="310" y="37" width="0" height="40">
        <node x="0" y="0" width="0" height="0"/>
        <node x="0" y="40" width="0" height="0"/>
      </node>
    </node>
  </expectations>
</test>
