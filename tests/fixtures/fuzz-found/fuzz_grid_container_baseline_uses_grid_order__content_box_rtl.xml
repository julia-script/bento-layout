<test name="fuzz_grid_container_baseline_uses_grid_order__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute" align-items="baseline">
      <div box-sizing="content-box" direction="rtl"/>
      <div box-sizing="content-box" direction="rtl">
        <div display="grid" box-sizing="content-box" direction="rtl" grid-auto-flow="column dense">
          <div box-sizing="content-box" direction="rtl" padding-top="120px" padding-left="320px" padding-bottom="40px" padding-right="320px" grid-column-start="2"/>
          <div box-sizing="content-box" direction="rtl" align-self="start"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="640" height="160">
      <node x="640" y="0" width="0" height="0"/>
      <node x="0" y="0" width="640" height="160">
        <node x="0" y="0" width="640" height="160">
          <node x="0" y="0" width="640" height="160"/>
          <node x="640" y="0" width="0" height="0"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
