<test name="fuzz_grid_normal_inline_alignment_preserves_ratio__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="ltr" position="absolute" width="120px" height="120px" grid-template-columns="60% 1fr">
      <div box-sizing="content-box" direction="ltr" align-self="stretch" aspect-ratio="3"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="120" height="120">
      <node x="0" y="0" width="360" height="120"/>
    </node>
  </expectations>
</test>
