<test name="fuzz_grid_rtl_oversized_span_track_side__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="ltr" position="absolute" width="120px" height="60px" grid-template-columns="1fr 1fr">
      <div direction="ltr" grid-column-start="span 3"/>
      <div direction="ltr"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="120" height="60">
      <node x="0" y="0" width="120" height="30"/>
      <node x="0" y="30" width="60" height="30"/>
    </node>
  </expectations>
</test>
