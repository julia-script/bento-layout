<test name="fuzz_column_reverse_container_baseline_order__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute" align-items="baseline">
      <div box-sizing="content-box" direction="rtl" flex-direction="column-reverse" row-gap="1px">
        <div box-sizing="content-box" direction="rtl"/>
        <div box-sizing="content-box" direction="rtl"/>
      </div>
      <div box-sizing="content-box" direction="rtl"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="0" height="1">
      <node x="0" y="0" width="0" height="1">
        <node x="0" y="1" width="0" height="0"/>
        <node x="0" y="0" width="0" height="0"/>
      </node>
      <node x="0" y="0" width="0" height="0"/>
    </node>
  </expectations>
</test>
