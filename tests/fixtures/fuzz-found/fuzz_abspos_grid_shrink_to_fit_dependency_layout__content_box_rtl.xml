<test name="fuzz_abspos_grid_shrink_to_fit_dependency_layout__content_box_rtl" use-rounding="true">
  <viewport width="1280px" height="800px"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="rtl" position="absolute">
      <div box-sizing="content-box" direction="rtl" aspect-ratio="1" padding-left="1px" padding-right="100%"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1" height="0">
      <node x="-1" y="0" width="2" height="0"/>
    </node>
  </expectations>
</test>
