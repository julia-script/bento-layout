<test name="fuzz_flex_column_auto_cross_uses_line_size__content_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="ltr" position="absolute" flex-direction="column" flex-wrap="wrap" align-items="end" max-width="97px">
      <div box-sizing="content-box" direction="ltr" margin-left="55px" margin-right="200px"/>
      <text box-sizing="content-box" direction="ltr">
        HH​HH​HHHH​HHH​H
      </text>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="97" height="20">
      <node x="55" y="0" width="0" height="0"/>
      <node x="135" y="0" width="120" height="20"/>
    </node>
  </expectations>
</test>
