<test name="fuzz_grid_min_contribution_clamp__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr">
      <div display="grid" direction="ltr">
        <div direction="ltr" width="40px" height="20px" max-width="10px"/>
      </div>
      <div display="grid" direction="ltr">
        <div direction="ltr" width="40px" height="20px" min-width="20px" max-width="10px"/>
      </div>
      <div display="grid" direction="ltr">
        <div direction="ltr" width="1px" height="40px" max-width="0px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="20" height="80">
      <node x="0" y="0" width="20" height="20">
        <node x="0" y="0" width="10" height="20"/>
      </node>
      <node x="0" y="20" width="20" height="20">
        <node x="0" y="0" width="20" height="20"/>
      </node>
      <node x="0" y="40" width="20" height="40">
        <node x="0" y="0" width="0" height="40"/>
      </node>
    </node>
  </expectations>
</test>
