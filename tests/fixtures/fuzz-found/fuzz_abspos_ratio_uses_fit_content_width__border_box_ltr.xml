<test name="fuzz_abspos_ratio_uses_fit_content_width__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div direction="ltr" position="absolute">
      <div display="block" direction="ltr">
        <text direction="ltr" position="absolute" aspect-ratio="0.5">
          H
        </text>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="0" height="0">
      <node x="0" y="0" width="0" height="0">
        <node x="0" y="0" width="10" height="20"/>
      </node>
    </node>
  </expectations>
</test>
