<test name="fuzz_abspos_space_between_uses_flex_start__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column-reverse" justify-content="space-between" width="10px" height="10px">
      <div box-sizing="content-box" direction="rtl" position="absolute" width="2px" height="3px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="10" height="10">
      <node x="8" y="7" width="2" height="3"/>
    </node>
  </expectations>
</test>
