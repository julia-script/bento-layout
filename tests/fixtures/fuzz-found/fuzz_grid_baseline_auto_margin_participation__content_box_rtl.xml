<test name="fuzz_grid_baseline_auto_margin_participation__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute">
      <div display="grid" box-sizing="content-box" direction="rtl" align-items="baseline" grid-template-columns="fit-content(55px) 1fr auto">
        <div box-sizing="content-box" direction="rtl" margin-left="1px" margin-bottom="auto" margin-right="auto"/>
        <div box-sizing="content-box" direction="rtl" width="20px" height="10px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="21" height="10">
      <node x="0" y="0" width="21" height="10">
        <node x="21" y="0" width="0" height="0"/>
        <node x="0" y="0" width="20" height="10"/>
      </node>
    </node>
  </expectations>
</test>
