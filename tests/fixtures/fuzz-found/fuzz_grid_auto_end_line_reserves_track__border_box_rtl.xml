<test name="fuzz_grid_auto_end_line_reserves_track__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="rtl" position="absolute" grid-auto-flow="column" grid-template-rows="1px" grid-template-columns="0px 10px">
      <div direction="rtl" grid-row-end="1"/>
      <div direction="rtl" grid-row-end="span 2"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="10" height="1">
      <node x="10" y="0" width="0" height="0"/>
      <node x="0" y="0" width="10" height="1"/>
    </node>
  </expectations>
</test>
