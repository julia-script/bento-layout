<test name="fuzz_block_ratio_explicit_min_disables_auto_floor__content_box_rtl" use-rounding="true">
  <viewport width="1280px" height="800px"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="0px">
      <div box-sizing="content-box" direction="rtl" height="0px" min-width="0%" aspect-ratio="1">
        <div box-sizing="content-box" direction="rtl" padding-left="1px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="0" height="0">
      <node x="0" y="0" width="0" height="0">
        <node x="-1" y="0" width="1" height="0"/>
      </node>
    </node>
  </expectations>
</test>
