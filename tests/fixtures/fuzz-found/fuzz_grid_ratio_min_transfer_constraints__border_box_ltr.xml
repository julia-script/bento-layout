<test name="fuzz_grid_ratio_min_transfer_constraints__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="ltr" position="absolute" grid-template-columns="auto auto">
      <div direction="ltr" width="1px" height="3px" min-height="97px" aspect-ratio="0.5"/>
      <div direction="ltr" height="3px" min-height="97px" max-width="20px" aspect-ratio="0.5"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="21" height="97">
      <node x="0" y="0" width="1" height="97"/>
      <node x="1" y="0" width="20" height="97"/>
    </node>
  </expectations>
</test>
