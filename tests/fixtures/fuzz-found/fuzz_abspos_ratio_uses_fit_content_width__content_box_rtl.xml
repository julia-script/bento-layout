<test name="fuzz_abspos_ratio_uses_fit_content_width__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div box-sizing="content-box" direction="rtl" position="absolute">
      <div display="block" box-sizing="content-box" direction="rtl">
        <text box-sizing="content-box" direction="rtl" position="absolute" aspect-ratio="0.5">
          H
        </text>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="0" height="0">
      <node x="0" y="0" width="0" height="0">
        <node x="-10" y="0" width="10" height="20"/>
      </node>
    </node>
  </expectations>
</test>
