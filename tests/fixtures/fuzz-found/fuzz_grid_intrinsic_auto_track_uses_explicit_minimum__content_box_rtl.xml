<test name="fuzz_grid_intrinsic_auto_track_uses_explicit_minimum__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="rtl" position="absolute" max-width="0px">
      <div display="grid" box-sizing="content-box" direction="rtl">
        <div box-sizing="content-box" direction="rtl" min-width="0px" min-height="1px" aspect-ratio="1"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="0" height="1">
      <node x="0" y="0" width="0" height="1">
        <node x="-1" y="0" width="1" height="1"/>
      </node>
    </node>
  </expectations>
</test>
