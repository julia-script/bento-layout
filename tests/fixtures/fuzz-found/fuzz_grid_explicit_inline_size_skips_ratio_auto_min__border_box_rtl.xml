<test name="fuzz_grid_explicit_inline_size_skips_ratio_auto_min__border_box_rtl" use-rounding="true">
  <viewport width="1280px" height="800px"/>
  <input>
    <div display="grid" direction="rtl" position="absolute" width="0px" height="0px">
      <div direction="rtl" width="0%" height="0%" aspect-ratio="1">
        <div direction="rtl" margin-right="1px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="0" height="0">
      <node x="0" y="0" width="0" height="0">
        <node x="-1" y="0" width="0" height="0"/>
      </node>
    </node>
  </expectations>
</test>
