<test name="fuzz_flex_column_grid_intrinsic_auto_minimum__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="flex" box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" width="10px" height="120px">
      <div display="grid" box-sizing="content-box" direction="rtl" grid-template-rows="max-content minmax(3px,1fr)">
        <div box-sizing="content-box" direction="rtl" padding-top="97px" padding-bottom="1px" grid-row-start="-2"/>
      </div>
      <div box-sizing="content-box" direction="rtl" min-height="90px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="10" height="120">
      <node x="0" y="0" width="10" height="98">
        <node x="0" y="0" width="10" height="98"/>
      </node>
      <node x="0" y="98" width="10" height="90"/>
    </node>
  </expectations>
</test>
