<test name="fuzz_grid_spanning_item_distributes_beyond_zero_limits__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="grid" direction="rtl" position="absolute" width="17px" height="20px" grid-template-columns="auto auto">
      <div direction="rtl" margin-left="55px" margin-right="120px" grid-column-start="1" grid-column-end="span 2"/>
      <div direction="rtl" grid-column-start="1"/>
      <div direction="rtl" width="72px" grid-column-start="2"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="17" height="20">
      <node x="-103" y="0" width="0" height="10"/>
      <node x="-34" y="10" width="51" height="10"/>
      <node x="-106" y="10" width="72" height="10"/>
    </node>
  </expectations>
</test>
