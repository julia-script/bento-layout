<test name="fuzz_grid_cyclic_inline_preserves_definite_block__content_box_rtl" use-rounding="true">
  <viewport width="1280px" height="800px"/>
  <input>
    <div display="grid" box-sizing="content-box" direction="rtl" position="absolute" width="0px" height="1px">
      <div box-sizing="content-box" direction="rtl" width="100%" aspect-ratio="1"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="0" height="1">
      <node x="-1" y="0" width="1" height="1"/>
    </node>
  </expectations>
</test>
