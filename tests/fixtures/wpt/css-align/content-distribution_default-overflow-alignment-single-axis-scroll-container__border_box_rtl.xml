      <node x="0" y="200" width="100" height="100" scroll_width="50" scroll_height="50">
        <node x="-50" y="-50" width="200" height="200"/>
      </node>
      <node x="0" y="300" width="100" height="100" scroll_width="50" scroll_height="50">
