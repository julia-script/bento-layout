      <div display="flex" direction="rtl" flex-wrap="wrap" overflow-x="clip" overflow-y="hidden" scrollbar-width="0" align-content="center" justify-content="center" width="100px" height="100px">
        <div display="block" direction="rtl" flex-shrink="0" width="200px" height="200px"/>
      </div>
      <div display="grid" direction="rtl" overflow-x="hidden" overflow-y="clip" scrollbar-width="0" align-content="center" justify-content="center" width="100px" height="100px" grid-template-rows="200px" grid-template-columns="200px">
