<test name="abspos_align-self-with-flex-grid-parent__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="rtl">
      <div display="block" direction="rtl" width="300px" height="300px">
        <div display="flex" direction="rtl" width="30px" height="30px" margin-left="270px">
          <div display="block" direction="rtl" position="absolute" align-self="center" justify-self="center" width="100px" height="100px" top="0px" left="0px" bottom="0px" right="0px"/>
        </div>
      </div>
      <div display="block" direction="rtl" width="300px" height="300px">
        <div display="grid" direction="rtl" width="30px" height="30px" margin-left="270px">
          <div display="block" direction="rtl" position="absolute" align-self="center" justify-self="center" width="100px" height="100px" top="0px" left="0px" bottom="0px" right="0px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="600">
      <node x="0" y="0" width="300" height="300">
        <node x="270" y="0" width="30" height="30">
          <node x="-70" y="0" width="100" height="100"/>
        </node>
      </node>
      <node x="0" y="300" width="300" height="300">
        <node x="270" y="0" width="30" height="30">
          <node x="-70" y="0" width="100" height="100"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
