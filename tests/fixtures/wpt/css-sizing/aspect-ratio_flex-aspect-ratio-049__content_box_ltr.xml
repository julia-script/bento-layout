<test name="aspect-ratio_flex-aspect-ratio-049__content_box_ltr" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr">
      <div display="flex" box-sizing="content-box" direction="ltr" width="0px" height="100px">
        <div display="block" box-sizing="content-box" direction="ltr" aspect-ratio="0.5">
          <div display="block" box-sizing="content-box" direction="ltr" width="100px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="100">
      <node x="0" y="0" width="0" height="100">
        <node x="0" y="0" width="100" height="100">
          <node x="0" y="0" width="100" height="0"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
