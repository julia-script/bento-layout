<test name="aspect-ratio_flex-aspect-ratio-052__content_box_rtl" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl">
      <div display="flex" box-sizing="content-box" direction="rtl" flex-direction="column" width="100px" height="0px">
        <div display="block" box-sizing="content-box" direction="rtl" width="100%" aspect-ratio="2">
          <div display="block" box-sizing="content-box" direction="rtl" height="100px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="0">
      <node x="1180" y="0" width="100" height="0">
        <node x="0" y="0" width="100" height="100">
          <node x="0" y="0" width="100" height="100"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
