<test name="abspos-auto-sizing-fit-content-percentage-002__content_box_rtl" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl">
      <div display="block" box-sizing="content-box" direction="rtl" width="100px" height="100px">
        <div display="block" box-sizing="content-box" direction="rtl" position="absolute">
          <div display="block" box-sizing="content-box" direction="rtl" width="100px" height="100px" margin-right="-50%"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="100">
      <node x="1180" y="0" width="100" height="100">
        <node x="0" y="0" width="100" height="100">
          <node x="50" y="0" width="100" height="100"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
