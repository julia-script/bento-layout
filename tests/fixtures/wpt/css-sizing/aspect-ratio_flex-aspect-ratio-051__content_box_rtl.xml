<test name="aspect-ratio_flex-aspect-ratio-051__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl">
      <div display="flex" box-sizing="content-box" direction="rtl" width="0px" height="100px">
        <div display="block" box-sizing="content-box" direction="rtl" height="100%" aspect-ratio="0.5">
          <div display="block" box-sizing="content-box" direction="rtl" width="100px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="0" height="100">
      <node x="0" y="0" width="0" height="100">
        <node x="-100" y="0" width="100" height="100">
          <node x="0" y="0" width="100" height="0"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
