<test name="abspos-auto-sizing-fit-content-percentage-001__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr">
      <div display="block" direction="ltr" width="100px" height="100px">
        <div display="block" direction="ltr" position="absolute">
          <div display="block" direction="ltr" width="100px" height="100px" margin-left="-50%"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="100">
        <node x="0" y="0" width="100" height="100">
          <node x="-50" y="0" width="100" height="100"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
