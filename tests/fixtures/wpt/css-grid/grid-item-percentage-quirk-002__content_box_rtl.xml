<test name="grid-item-percentage-quirk-002__content_box_rtl" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl">
      <div display="block" box-sizing="content-box" direction="rtl" overflow-x="hidden" overflow-y="hidden" scrollbar-width="0" width="100px" height="100px">
        <div display="grid" box-sizing="content-box" direction="rtl" left="-20px">
          <div display="block" box-sizing="content-box" direction="rtl" width="200px" height="200%"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="100">
      <node x="1180" y="0" width="100" height="100" scroll_width="0" scroll_height="0">
        <node x="-20" y="0" width="100" height="0">
          <node x="-100" y="0" width="200" height="0"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
