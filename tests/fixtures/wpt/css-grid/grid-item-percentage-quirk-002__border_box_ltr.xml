<test name="grid-item-percentage-quirk-002__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr">
      <div display="block" direction="ltr" overflow-x="hidden" overflow-y="hidden" scrollbar-width="0" width="100px" height="100px">
        <div display="grid" direction="ltr" left="-20px">
          <div display="block" direction="ltr" width="200px" height="200%"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="100" scroll_width="0" scroll_height="0">
        <node x="-20" y="0" width="100" height="0">
          <node x="0" y="0" width="200" height="0"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
