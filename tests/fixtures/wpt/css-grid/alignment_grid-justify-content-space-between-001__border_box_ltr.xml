<test name="alignment_grid-justify-content-space-between-001__border_box_ltr" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" direction="ltr">
      <div display="grid" direction="ltr" justify-content="space-between" width="100px" height="50px" grid-template-rows="50px" grid-template-columns="25px 25px">
        <div display="block" direction="ltr" width="25px" height="50px" grid-row-start="1" grid-row-end="2" grid-column-start="1" grid-column-end="2"/>
        <div display="block" direction="ltr" width="25px" height="50px" grid-row-start="1" grid-row-end="2" grid-column-start="2" grid-column-end="3"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="50">
      <node x="0" y="0" width="100" height="50">
        <node x="0" y="0" width="25" height="50"/>
        <node x="75" y="0" width="25" height="50"/>
      </node>
    </node>
  </expectations>
</test>
