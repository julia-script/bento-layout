<test name="grid-overflowing-multiple-items-are-painted__border_box_ltr" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" direction="ltr">
      <div display="grid" direction="ltr" width="0px" height="0px" grid-template-rows="40px 40px" grid-template-columns="40px 40px">
        <div display="block" direction="ltr" width="100px" height="30px" grid-row-start="1" grid-row-end="2" grid-column-start="1" grid-column-end="2"/>
        <div display="block" direction="ltr" width="30px" height="100px" grid-row-start="2" grid-row-end="3" grid-column-start="2" grid-column-end="3"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="0">
      <node x="0" y="0" width="0" height="0">
        <node x="0" y="0" width="100" height="30"/>
        <node x="40" y="40" width="30" height="100"/>
      </node>
    </node>
  </expectations>
</test>
