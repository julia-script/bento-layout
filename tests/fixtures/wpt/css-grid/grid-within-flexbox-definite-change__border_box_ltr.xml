<test name="grid-within-flexbox-definite-change__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr">
      <div display="flex" direction="ltr" flex-direction="column" width="100px" height="110px">
        <div display="grid" direction="ltr" height="100px">
          <div display="block" direction="ltr"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="110">
      <node x="0" y="0" width="100" height="110">
        <node x="0" y="0" width="100" height="100">
          <node x="0" y="0" width="100" height="100"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
