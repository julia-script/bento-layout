<test name="grid-within-flexbox-indefinite__content_box_rtl" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl">
      <div display="flex" box-sizing="content-box" direction="rtl" flex-direction="column" width="100px" min-height="100px">
        <div display="grid" box-sizing="content-box" direction="rtl" flex-grow="1" flex-basis="0%">
          <div display="block" box-sizing="content-box" direction="rtl"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="100">
      <node x="1180" y="0" width="100" height="100">
        <node x="0" y="0" width="100" height="100">
          <node x="0" y="0" width="100" height="100"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
