      <div display="grid" direction="ltr" width="400px" height="400px" padding-top="20px" padding-left="20px" padding-bottom="20px" padding-right="20px" grid-template-rows="200px 200px" grid-template-columns="200px 200px">
        <div display="block" direction="ltr" grid-row-start="1" grid-row-end="2" grid-column-start="1" grid-column-end="2">
          <div display="block" direction="ltr" position="absolute" width="50%" height="50%" grid-row-start="1" grid-row-end="2" grid-column-start="1" grid-column-end="2"/>
        </div>
      </div>
    </div>
