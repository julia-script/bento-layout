<test name="alignment_grid-content-distribution-029__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr">
      <div display="grid" direction="ltr" align-content="center" width="100px" max-width="50px" aspect-ratio="2">
        <div display="block" direction="ltr" width="100px" height="100px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="50" height="100">
      <node x="0" y="0" width="50" height="100">
        <node x="0" y="0" width="100" height="100"/>
      </node>
    </node>
  </expectations>
</test>
