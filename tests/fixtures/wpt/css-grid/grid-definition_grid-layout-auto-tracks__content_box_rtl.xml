    <div display="block" box-sizing="content-box" direction="rtl">
      <div display="grid" box-sizing="content-box" direction="rtl" width="100px" grid-template-rows="auto" grid-template-columns="100px">
        <text display="block" box-sizing="content-box" direction="rtl" grid-row-start="1" grid-column-start="1">
          
        </text>
        <div display="block" box-sizing="content-box" direction="rtl" grid-row-start="1" grid-column-start="2">
          <text display="block" box-sizing="content-box" direction="rtl" width="50px">
            
          </text>
        </div>
        <text display="block" box-sizing="content-box" direction="rtl" grid-row-start="2" grid-column-start="1">
          
        </text>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="20">
      <node x="0" y="0" width="100" height="20">
        <node x="0" y="0" width="100" height="10"/>
        <node x="-50" y="0" width="50" height="10">
          <node x="0" y="0" width="50" height="10"/>
        </node>
        <node x="0" y="10" width="100" height="10"/>
      </node>
    </node>
  </expectations>
</test>
