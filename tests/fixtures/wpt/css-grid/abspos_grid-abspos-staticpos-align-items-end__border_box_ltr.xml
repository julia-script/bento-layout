<test name="abspos_grid-abspos-staticpos-align-items-end__border_box_ltr" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" direction="ltr">
      <div display="grid" direction="ltr" align-items="end" width="100px" height="100px" border-top="1px" border-left="1px" border-bottom="1px" border-right="1px">
        <div display="block" direction="ltr" position="absolute" width="50px" height="50px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="100">
      <node x="0" y="0" width="100" height="100">
        <node x="1" y="49" width="50" height="50"/>
      </node>
    </node>
  </expectations>
</test>
