<test name="grid-definition_flex-item-grid-container-auto-repeat-002__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="rtl">
      <div display="flex" direction="rtl" width="100px" height="100px">
        <div display="block" direction="rtl" flex-shrink="0" width="50px"/>
        <div display="grid" direction="rtl" width="200px" grid-template-columns="repeat(auto-fill, 50px)"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="100">
        <node x="50" y="0" width="50" height="100"/>
        <node x="0" y="0" width="50" height="100"/>
      </node>
    </node>
  </expectations>
</test>
