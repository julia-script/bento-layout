<test name="abspos_positioned-grid-descendant-containing-block-003__border_box_ltr" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" direction="ltr">
      <div display="grid" direction="ltr" width="200px" height="200px" grid-template-rows="200px" grid-template-columns="200px">
        <div display="block" direction="ltr" grid-row-start="1" grid-row-end="2" grid-column-start="1" grid-column-end="2">
          <div display="block" direction="ltr" position="absolute" width="50%" height="50%"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="200">
      <node x="0" y="0" width="200" height="200">
        <node x="0" y="0" width="200" height="200">
          <node x="0" y="0" width="100" height="100"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
