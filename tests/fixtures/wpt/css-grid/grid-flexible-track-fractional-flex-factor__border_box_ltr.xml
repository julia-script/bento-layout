<test name="grid-flexible-track-fractional-flex-factor__border_box_ltr" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" direction="ltr">
      <div display="grid" direction="ltr" width="600px" grid-template-rows="100px" grid-template-columns="1.01fr 0.99fr 1fr">
        <div display="block" direction="ltr" grid-row-start="1" grid-row-end="2" grid-column-start="1" grid-column-end="2"/>
        <div display="block" direction="ltr" grid-row-start="1" grid-row-end="2" grid-column-start="2" grid-column-end="3"/>
        <div display="block" direction="ltr" grid-row-start="1" grid-row-end="2" grid-column-start="3" grid-column-end="4"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="100">
      <node x="0" y="0" width="600" height="100">
        <node x="0" y="0" width="202" height="100"/>
        <node x="202" y="0" width="198" height="100"/>
        <node x="400" y="0" width="200" height="100"/>
      </node>
    </node>
  </expectations>
</test>
