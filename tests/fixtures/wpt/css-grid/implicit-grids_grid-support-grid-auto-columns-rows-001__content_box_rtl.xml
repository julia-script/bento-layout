<test name="implicit-grids_grid-support-grid-auto-columns-rows-001__content_box_rtl" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl">
      <div display="grid" box-sizing="content-box" direction="rtl" grid-auto-rows="30px" grid-auto-columns="30px">
        <div display="block" box-sizing="content-box" direction="rtl" grid-row-start="1" grid-column-start="1"/>
        <div display="block" box-sizing="content-box" direction="rtl" grid-row-start="1" grid-row-end="span 2" grid-column-start="3"/>
        <div display="block" box-sizing="content-box" direction="rtl" grid-row-start="2" grid-column-start="1" grid-column-end="span 2"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="60">
      <node x="0" y="0" width="1280" height="60">
        <node x="1250" y="0" width="30" height="30"/>
        <node x="1190" y="0" width="30" height="60"/>
        <node x="1220" y="30" width="60" height="30"/>
      </node>
    </node>
  </expectations>
</test>
