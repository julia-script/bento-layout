<test name="grid-overflowing-item-right-of-container-is-painted__content_box_ltr" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr">
      <div display="grid" box-sizing="content-box" direction="ltr" width="0px" height="100px" grid-template-rows="auto" grid-template-columns="auto">
        <div display="block" box-sizing="content-box" direction="ltr" width="100px" height="100px" grid-row-start="1" grid-row-end="2" grid-column-start="1" grid-column-end="2"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="100">
      <node x="0" y="0" width="0" height="100">
        <node x="0" y="0" width="100" height="100"/>
      </node>
    </node>
  </expectations>
</test>
