<test name="abspos_positioned-grid-descendant-containing-block-007__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr">
      <div display="grid" direction="ltr" width="100px" height="100px" grid-template-rows="100px" grid-template-columns="50px 50px">
        <div display="block" direction="ltr" grid-row-start="1" grid-row-end="2" grid-column-start="1" grid-column-end="2">
          <div display="block" direction="ltr" position="absolute" width="100%" height="100%" grid-column-start="1" grid-column-end="10"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="100">
        <node x="0" y="0" width="50" height="100">
          <node x="0" y="0" width="50" height="100"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
