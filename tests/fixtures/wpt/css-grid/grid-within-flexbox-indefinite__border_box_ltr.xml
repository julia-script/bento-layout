<test name="grid-within-flexbox-indefinite__border_box_ltr" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" direction="ltr">
      <div display="flex" direction="ltr" flex-direction="column" width="100px" min-height="100px">
        <div display="grid" direction="ltr" flex-grow="1" flex-basis="0%">
          <div display="block" direction="ltr"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="100">
      <node x="0" y="0" width="100" height="100">
        <node x="0" y="0" width="100" height="100">
          <node x="0" y="0" width="100" height="100"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
