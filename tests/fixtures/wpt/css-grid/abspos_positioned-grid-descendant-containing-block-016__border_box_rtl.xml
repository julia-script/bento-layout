<test name="abspos_positioned-grid-descendant-containing-block-016__border_box_rtl" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" direction="rtl">
      <div display="grid" direction="rtl" width="200px" height="200px" grid-template-rows="100px 100px" grid-template-columns="100px 100px">
        <div display="block" direction="rtl" grid-row-start="1" grid-row-end="2" grid-column-start="1" grid-column-end="2">
          <div display="block" direction="rtl" position="absolute" width="50%" height="50%" grid-row-start="1" grid-row-end="3" grid-column-start="1" grid-column-end="3"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="200">
      <node x="1080" y="0" width="200" height="200">
        <node x="100" y="0" width="100" height="100">
          <node x="50" y="0" width="50" height="50"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
