<test name="grid-overflowing-item-below-container-is-painted__border_box_rtl" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" direction="rtl">
      <div display="grid" direction="rtl" width="100px" height="0px" grid-template-rows="auto" grid-template-columns="auto">
        <div display="block" direction="rtl" width="100px" height="100px" grid-row-start="1" grid-row-end="2" grid-column-start="1" grid-column-end="2"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="0">
      <node x="1180" y="0" width="100" height="0">
        <node x="0" y="0" width="100" height="100"/>
      </node>
    </node>
  </expectations>
</test>
