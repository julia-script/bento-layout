<test name="grid-items_percentage-size-subitems-002__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl">
      <div display="grid" box-sizing="content-box" direction="rtl" grid-template-columns="100px 100px">
        <div display="block" box-sizing="content-box" direction="rtl" min-height="100px">
          <div display="block" box-sizing="content-box" direction="rtl" height="100%"/>
        </div>
        <div display="block" box-sizing="content-box" direction="rtl" height="100px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="200" height="100">
      <node x="0" y="0" width="200" height="100">
        <node x="100" y="0" width="100" height="100">
          <node x="0" y="0" width="100" height="100"/>
        </node>
        <node x="0" y="0" width="100" height="100"/>
      </node>
    </node>
  </expectations>
</test>
