<test name="abspos_positioned-grid-items-018__content_box_rtl" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl">
      <div display="grid" box-sizing="content-box" direction="rtl" max-width="100px" max-height="100px" grid-template-rows="200px" grid-template-columns="200px">
        <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="100%" height="100%"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="100">
      <node x="1180" y="0" width="100" height="100">
        <node x="0" y="0" width="100" height="100"/>
      </node>
    </node>
  </expectations>
</test>
