<test name="grid-definition_flex-item-grid-container-auto-repeat-002__content_box_ltr" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr">
      <div display="flex" box-sizing="content-box" direction="ltr" width="100px" height="100px">
        <div display="block" box-sizing="content-box" direction="ltr" flex-shrink="0" width="50px"/>
        <div display="grid" box-sizing="content-box" direction="ltr" width="200px" grid-template-columns="repeat(auto-fill, 50px)"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="100">
      <node x="0" y="0" width="100" height="100">
        <node x="0" y="0" width="50" height="100"/>
        <node x="50" y="0" width="50" height="100"/>
      </node>
    </node>
  </expectations>
</test>
