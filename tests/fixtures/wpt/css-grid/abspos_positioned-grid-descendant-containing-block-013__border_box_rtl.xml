    <div display="block" direction="rtl">
      <div display="grid" direction="rtl" width="400px" padding-top="20px" padding-left="20px" padding-bottom="20px" padding-right="20px" grid-template-rows="200px 200px" grid-template-columns="200px 200px">
        <div display="block" direction="rtl" grid-row-start="1" grid-row-end="2" grid-column-start="1" grid-column-end="2">
          <div display="block" direction="rtl" position="absolute" width="50%" height="50%" grid-row-start="1" grid-row-end="2" grid-column-start="1" grid-column-end="2"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="440">
      <node x="0" y="0" width="400" height="440">
        <node x="180" y="20" width="200" height="200">
          <node x="100" y="0" width="100" height="100"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
