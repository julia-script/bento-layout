<test name="implicit-grids_grid-support-grid-auto-columns-rows-002__border_box_rtl" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" direction="rtl">
      <div display="grid" direction="rtl" grid-auto-rows="40px 30px" grid-auto-columns="25px 50px">
        <div display="block" direction="rtl" grid-row-start="1" grid-column-start="1"/>
        <div display="block" direction="rtl" grid-row-start="1" grid-column-start="2"/>
        <div display="block" direction="rtl" grid-row-start="2" grid-column-start="1"/>
        <div display="block" direction="rtl" grid-row-start="2" grid-column-start="2"/>
        <div display="block" direction="rtl" grid-row-start="3" grid-column-start="1" grid-column-end="span 2"/>
        <div display="block" direction="rtl" grid-row-start="1" grid-row-end="span 3" grid-column-start="3"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="110">
      <node x="0" y="0" width="1280" height="110">
        <node x="1255" y="0" width="25" height="40"/>
        <node x="1205" y="0" width="50" height="40"/>
        <node x="1255" y="40" width="25" height="30"/>
        <node x="1205" y="40" width="50" height="30"/>
        <node x="1205" y="70" width="75" height="40"/>
        <node x="1180" y="0" width="25" height="110"/>
      </node>
    </node>
  </expectations>
</test>
