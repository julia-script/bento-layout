<test name="alignment_grid-content-distribution-027__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl">
      <div display="grid" box-sizing="content-box" direction="rtl" align-content="space-around" justify-content="space-around" width="50px" height="50px">
        <div display="block" box-sizing="content-box" direction="rtl" width="100px" height="100px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="50" height="50">
      <node x="0" y="0" width="50" height="50">
        <node x="-50" y="0" width="100" height="100"/>
      </node>
    </node>
  </expectations>
</test>
