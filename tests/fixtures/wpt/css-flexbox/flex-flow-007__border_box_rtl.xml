  <input>
    <div display="block" direction="rtl">
      <div display="flex" direction="rtl" flex-direction="column" width="100px" height="100px">
        <text display="block" direction="rtl" height="50px">
          1
        </text>
        <text display="block" direction="rtl" height="50px">
          2
        </text>
        <text display="block" direction="rtl" height="50px">
          3
        </text>
        <text display="block" direction="rtl" height="50px">
          4
        </text>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="100">
        <node x="0" y="0" width="100" height="25"/>
        <node x="0" y="25" width="100" height="25"/>
        <node x="0" y="50" width="100" height="25"/>
        <node x="0" y="75" width="100" height="25"/>
      </node>
    </node>
  </expectations>
</test>
