<test name="flex-margin-no-collapse__content_box_rtl" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl">
      <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="100px" height="100px" top="350px" left="10px"/>
      <div display="flex" box-sizing="content-box" direction="rtl" position="absolute" flex-direction="column" width="200px" height="300px" top="100px" left="10px">
        <div display="block" box-sizing="content-box" direction="rtl" flex-shrink="0" width="100px" height="100px" margin-top="50px" margin-left="0px" margin-bottom="50px" margin-right="0px"/>
        <div display="block" box-sizing="content-box" direction="rtl" flex-shrink="0" width="100px" height="100px" margin-top="50px" margin-left="0px" margin-bottom="50px" margin-right="0px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="0">
      <node x="10" y="350" width="100" height="100"/>
      <node x="10" y="100" width="200" height="300">
        <node x="100" y="50" width="100" height="100"/>
        <node x="100" y="250" width="100" height="100"/>
      </node>
    </node>
  </expectations>
</test>
