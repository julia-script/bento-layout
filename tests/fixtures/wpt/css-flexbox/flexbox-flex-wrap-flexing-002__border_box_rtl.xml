<test name="flexbox-flex-wrap-flexing-002__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="rtl">
      <div display="flex" direction="rtl" flex-direction="column" flex-wrap="wrap" width="100px" max-height="100px">
        <div display="block" direction="rtl" flex-grow="1" width="50px" height="50px"/>
        <div display="block" direction="rtl" width="50px" height="100px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="100">
        <node x="50" y="0" width="50" height="100"/>
        <node x="0" y="0" width="50" height="100"/>
      </node>
    </node>
  </expectations>
</test>
