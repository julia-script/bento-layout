<test name="flex-minimum-height-flex-items-012__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="rtl">
      <div display="block" direction="rtl"/>
      <div display="flex" direction="rtl" flex-direction="column" width="100px" height="100px">
        <div display="block" direction="rtl" flex-grow="0.1" flex-basis="0%" height="10px"/>
        <div display="flex" direction="rtl" flex-grow="0.9" flex-basis="0%" height="100%">
          <div display="block" direction="rtl" height="100%"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="0"/>
      <node x="0" y="0" width="100" height="100">
        <node x="0" y="0" width="100" height="10"/>
        <node x="0" y="10" width="100" height="90">
          <node x="100" y="0" width="0" height="90"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
