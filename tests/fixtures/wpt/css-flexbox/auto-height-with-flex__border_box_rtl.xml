<test name="auto-height-with-flex__border_box_rtl" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" direction="rtl">
      <div display="flex" direction="rtl" flex-direction="column" border-top="1px" border-left="1px" border-bottom="1px" border-right="1px">
        <text display="block" direction="rtl">
          Header
        </text>
        <text display="block" direction="rtl" flex-grow="1" flex-basis="0%">
          Flexible content
        </text>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="22">
      <node x="0" y="0" width="1280" height="22">
        <node x="1" y="1" width="1278" height="10"/>
        <node x="1" y="11" width="1278" height="10"/>
      </node>
    </node>
  </expectations>
</test>
