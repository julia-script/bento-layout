<test name="percentage-widths-001__border_box_rtl" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" direction="rtl">
      <div display="flex" direction="rtl" position="absolute" top="0px" left="0px" bottom="0px" right="0px">
        <text display="block" direction="rtl" width="20%">
          Tests that percentage widths get resolved correctly when the flexbox is
        </text>
        <text display="block" direction="rtl" flex-basis="100%">
          absolutely positioned without an explicit width. You should see no red.
        </text>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="0">
      <node x="0" y="0" width="1280" height="0">
        <node x="1067" y="0" width="213" height="0"/>
        <node x="0" y="0" width="1067" height="0"/>
      </node>
    </node>
  </expectations>
</test>
