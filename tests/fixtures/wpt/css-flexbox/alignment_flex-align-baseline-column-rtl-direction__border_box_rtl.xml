<test name="alignment_flex-align-baseline-column-rtl-direction__border_box_rtl" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" direction="rtl">
      <div display="flex" direction="rtl" flex-direction="column" align-items="baseline" width="100px" height="100px">
        <div display="block" direction="rtl" position="absolute" width="50px" height="100px" right="50px"/>
        <div display="block" direction="rtl" width="50px" height="100px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="100">
      <node x="1180" y="0" width="100" height="100">
        <node x="0" y="0" width="50" height="100"/>
        <node x="50" y="0" width="50" height="100"/>
      </node>
    </node>
  </expectations>
</test>
