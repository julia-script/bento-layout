<test name="flex-item-position-relative-001__content_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="rtl">
      <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="50px" height="50px" top="50px" left="50px"/>
      <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="50px" height="50px" top="100px" left="100px"/>
      <div display="flex" box-sizing="content-box" direction="rtl" width="100px" height="100px">
        <div display="block" box-sizing="content-box" direction="rtl" width="50px" height="50px" top="50px" left="50px">
          <div display="block" box-sizing="content-box" direction="rtl" position="absolute" width="50px" height="50px" top="100%" left="100%"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="50" y="50" width="50" height="50"/>
      <node x="100" y="100" width="50" height="50"/>
      <node x="0" y="0" width="100" height="100">
        <node x="100" y="50" width="50" height="50">
          <node x="50" y="50" width="50" height="50"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
