      <div display="flex" box-sizing="content-box" direction="ltr" flex-direction="column" width="100px" border-top="2px" border-left="2px" border-bottom="2px" border-right="2px">
        <div display="flex" box-sizing="content-box" direction="ltr" flex-direction="column" justify-content="flex-end" flex-shrink="0" flex-basis="50px" min-height="50px">
          <div display="block" box-sizing="content-box" direction="ltr" width="30px" height="30px"/>
