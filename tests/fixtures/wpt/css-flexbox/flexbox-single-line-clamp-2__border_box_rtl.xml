<test name="flexbox-single-line-clamp-2__border_box_rtl" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" direction="rtl">
      <div display="flex" direction="rtl" flex-direction="column" height="500px" max-width="250px">
        <div display="block" direction="rtl" border-top="1px" border-left="1px" border-bottom="1px" border-right="1px">
          <div display="block" direction="rtl" width="100px" height="100px"/>
        </div>
        <div display="block" direction="rtl" border-top="1px" border-left="1px" border-bottom="1px" border-right="1px">
          <div display="block" direction="rtl" width="500px" height="100px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="500">
      <node x="1030" y="0" width="250" height="500">
        <node x="0" y="0" width="250" height="102">
          <node x="149" y="1" width="100" height="100"/>
        </node>
        <node x="0" y="102" width="250" height="102">
          <node x="-251" y="1" width="500" height="100"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
