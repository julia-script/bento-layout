  <input>
    <div display="block" direction="rtl">
      <div display="flex" direction="rtl" flex-direction="column">
        <div display="flex" direction="rtl" height="100px">
          <div display="block" direction="rtl" width="100px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="100">
        <node x="0" y="0" width="100" height="100">
          <node x="0" y="0" width="100" height="100"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
