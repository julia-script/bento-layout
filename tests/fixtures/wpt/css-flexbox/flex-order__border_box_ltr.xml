<test name="flex-order__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr">
      <div display="flex" direction="ltr">
        <div display="block" direction="ltr" width="100px" height="100px"/>
        <div display="block" direction="ltr" width="100px" height="100px"/>
        <div display="block" direction="ltr" width="100px" height="100px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="300" height="100">
      <node x="0" y="0" width="300" height="100">
        <node x="0" y="0" width="100" height="100"/>
        <node x="200" y="0" width="100" height="100"/>
        <node x="100" y="0" width="100" height="100"/>
      </node>
    </node>
  </expectations>
</test>
