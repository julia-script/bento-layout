<test name="padding-overflow__border_box_ltr" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" direction="ltr">
      <div display="flex" direction="ltr">
        <div display="block" direction="ltr" overflow-x="hidden" overflow-y="hidden" scrollbar-width="0" padding-top="50px" padding-left="50px" padding-bottom="50px" padding-right="50px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="100">
      <node x="0" y="0" width="1280" height="100">
        <node x="0" y="0" width="100" height="100" scroll_width="0" scroll_height="0"/>
      </node>
    </node>
  </expectations>
</test>
