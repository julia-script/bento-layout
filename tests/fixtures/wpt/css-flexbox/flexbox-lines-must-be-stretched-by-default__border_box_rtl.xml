<test name="flexbox-lines-must-be-stretched-by-default__border_box_rtl" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" direction="rtl">
      <div display="flex" direction="rtl" flex-wrap="wrap" width="200px" height="100px">
        <div display="block" direction="rtl" width="100%" border-top="1px" border-left="1px" border-bottom="1px" border-right="1px"/>
        <div display="block" direction="rtl" width="100%"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="100">
      <node x="1080" y="0" width="200" height="100">
        <node x="0" y="0" width="200" height="51"/>
        <node x="0" y="51" width="200" height="49"/>
      </node>
    </node>
  </expectations>
</test>
