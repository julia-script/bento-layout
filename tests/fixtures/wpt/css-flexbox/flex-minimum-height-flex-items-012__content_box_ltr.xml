    <div display="block" box-sizing="content-box" direction="ltr">
      <div display="block" box-sizing="content-box" direction="ltr"/>
      <div display="flex" box-sizing="content-box" direction="ltr" flex-direction="column" width="100px" height="100px">
        <div display="block" box-sizing="content-box" direction="ltr" flex-grow="0.1" flex-basis="0%" height="10px"/>
        <div display="flex" box-sizing="content-box" direction="ltr" flex-grow="0.9" flex-basis="0%" height="100%">
          <div display="block" box-sizing="content-box" direction="ltr" height="100%"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="100">
      <node x="0" y="0" width="1280" height="0"/>
      <node x="0" y="0" width="100" height="100">
        <node x="0" y="0" width="100" height="10"/>
        <node x="0" y="10" width="100" height="90">
          <node x="0" y="0" width="0" height="90"/>
        </node>
      </node>
    </node>
  </expectations>
