<test name="justify-content_space-between-002__content_box_ltr" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr">
      <div display="flex" box-sizing="content-box" direction="ltr" flex-direction="column" justify-content="space-between" min-height="500px">
        <text display="block" box-sizing="content-box" direction="ltr">
          First item
        </text>
        <text display="block" box-sizing="content-box" direction="ltr">
          Second item
        </text>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="500">
      <node x="0" y="0" width="1280" height="500">
        <node x="0" y="0" width="1280" height="10"/>
        <node x="0" y="490" width="1280" height="10"/>
      </node>
    </node>
  </expectations>
</test>
