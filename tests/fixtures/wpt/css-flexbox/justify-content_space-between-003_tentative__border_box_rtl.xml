<test name="justify-content_space-between-003_tentative__border_box_rtl" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" direction="rtl">
      <div display="flex" direction="rtl" flex-direction="column-reverse" overflow-x="hidden" overflow-y="hidden" scrollbar-width="0" justify-content="space-between" width="100px" height="50px">
        <div display="block" direction="rtl" height="300px">
          <div display="block" direction="rtl" width="200px" height="200px"/>
          <div display="block" direction="rtl" width="100px" height="50px"/>
        </div>
      </div>
      <div display="flex" direction="rtl" flex-direction="row-reverse" overflow-x="hidden" overflow-y="hidden" scrollbar-width="0" justify-content="space-between" width="100px" height="50px">
        <div display="flex" direction="rtl" width="300px">
          <div display="block" direction="rtl" width="200px" height="50px"/>
          <div display="block" direction="rtl" width="100px" height="50px"/>
        </div>
      </div>
    </div>
