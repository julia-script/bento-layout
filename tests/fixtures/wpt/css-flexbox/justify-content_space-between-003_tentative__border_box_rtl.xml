      <node x="1180" y="50" width="100" height="50" scroll_width="200" scroll_height="0">
        <node x="0" y="0" width="300" height="50">
          <node x="100" y="0" width="200" height="50"/>
          <node x="0" y="0" width="100" height="50"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
