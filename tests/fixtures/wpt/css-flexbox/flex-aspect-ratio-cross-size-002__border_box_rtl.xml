<test name="flex-aspect-ratio-cross-size-002__border_box_rtl" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" direction="rtl">
      <div display="block" direction="rtl" width="200px">
        <div display="flex" direction="rtl" aspect-ratio="4">
          <div display="flex" direction="rtl" aspect-ratio="1">
            <div display="block" direction="rtl">
              <div display="block" direction="rtl" height="100%" aspect-ratio="2"/>
            </div>
          </div>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="50">
      <node x="1080" y="0" width="200" height="50">
        <node x="0" y="0" width="200" height="50">
          <node x="100" y="0" width="100" height="50">
            <node x="0" y="0" width="100" height="50">
              <node x="0" y="0" width="100" height="50"/>
            </node>
          </node>
        </node>
      </node>
    </node>
  </expectations>
</test>
