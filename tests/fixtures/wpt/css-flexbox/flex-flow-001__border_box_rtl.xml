<test name="flex-flow-001__border_box_rtl" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" direction="rtl">
      <div display="flex" direction="rtl" width="100px">
        <text display="block" direction="rtl" width="50px" height="50px">
          1
        </text>
        <text display="block" direction="rtl" width="50px" height="50px">
          2
        </text>
        <text display="block" direction="rtl" width="50px" height="50px">
          3
        </text>
        <text display="block" direction="rtl" width="50px" height="50px">
          4
        </text>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="50">
      <node x="1180" y="0" width="100" height="50">
        <node x="75" y="0" width="25" height="50"/>
        <node x="50" y="0" width="25" height="50"/>
        <node x="25" y="0" width="25" height="50"/>
        <node x="0" y="0" width="25" height="50"/>
      </node>
    </node>
  </expectations>
</test>
