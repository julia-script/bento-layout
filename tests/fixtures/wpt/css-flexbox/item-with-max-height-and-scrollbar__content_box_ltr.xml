<test name="item-with-max-height-and-scrollbar__content_box_ltr" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr">
      <div display="flex" box-sizing="content-box" direction="ltr" flex-direction="column" width="100px">
        <div display="block" box-sizing="content-box" direction="ltr" overflow-x="scroll" overflow-y="scroll" scrollbar-width="0" min-height="0px" max-height="100%">
          <text display="block" box-sizing="content-box" direction="ltr" width="100px" height="100px">
            
          </text>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="100">
      <node x="0" y="0" width="100" height="100">
        <node x="0" y="0" width="100" height="100" scroll_width="0" scroll_height="0">
          <node x="0" y="0" width="100" height="100"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
