<test name="order-painting__border_box_ltr" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="ltr">
      <div display="flex" direction="ltr" width="100px">
        <div display="block" direction="ltr" width="100px" height="100px" margin-left="-50px"/>
        <div display="block" direction="ltr" width="50px" height="100px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="0" y="0" width="100" height="100">
        <node x="0" y="0" width="100" height="100"/>
        <node x="0" y="0" width="50" height="100"/>
      </node>
    </node>
  </expectations>
</test>
