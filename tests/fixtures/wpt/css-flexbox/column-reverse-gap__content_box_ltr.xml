    <div display="block" box-sizing="content-box" direction="ltr">
      <div display="block" box-sizing="content-box" direction="ltr"/>
      <div display="flex" box-sizing="content-box" direction="ltr" flex-direction="column-reverse" row-gap="5px" column-gap="5px">
        <div display="block" box-sizing="content-box" direction="ltr" height="10px"/>
        <div display="block" box-sizing="content-box" direction="ltr" height="10px"/>
        <div display="block" box-sizing="content-box" direction="ltr" height="10px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="40">
      <node x="0" y="0" width="1280" height="0"/>
      <node x="0" y="0" width="1280" height="40">
        <node x="0" y="30" width="1280" height="10"/>
        <node x="0" y="15" width="1280" height="10"/>
        <node x="0" y="0" width="1280" height="10"/>
      </node>
    </node>
  </expectations>
</test>
