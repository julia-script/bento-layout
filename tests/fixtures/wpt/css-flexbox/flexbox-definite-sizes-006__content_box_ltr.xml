<test name="flexbox-definite-sizes-006__content_box_ltr" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" box-sizing="content-box" direction="ltr">
      <div display="flex" box-sizing="content-box" direction="ltr" flex-direction="column">
        <div display="flex" box-sizing="content-box" direction="ltr" height="100px">
          <div display="block" box-sizing="content-box" direction="ltr" width="100px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="100">
      <node x="0" y="0" width="1280" height="100">
        <node x="0" y="0" width="1280" height="100">
          <node x="0" y="0" width="100" height="100"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
