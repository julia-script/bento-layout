<test name="empty-flex-box-and-margin-collapsing__border_box_ltr" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" direction="ltr">
      <div display="block" direction="ltr" width="100px" height="50px">
        <div display="flex" direction="ltr" margin-top="0px" margin-bottom="200px"/>
      </div>
      <div display="block" direction="ltr" width="100px" height="50px">
        <div display="grid" direction="ltr" margin-top="0px" margin-bottom="200px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="100">
      <node x="0" y="0" width="100" height="50">
        <node x="0" y="0" width="100" height="0"/>
      </node>
      <node x="0" y="50" width="100" height="50">
        <node x="0" y="0" width="100" height="0"/>
      </node>
    </node>
  </expectations>
</test>
