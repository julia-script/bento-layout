<test name="flexbox_justifycontent-stretch__border_box_rtl" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" direction="rtl">
      <div display="flex" direction="rtl" justify-content="stretch" width="200px" height="100px">
        <div display="block" direction="rtl" width="50px"/>
        <div display="block" direction="rtl" width="50px"/>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="100">
      <node x="1080" y="0" width="200" height="100">
        <node x="150" y="0" width="50" height="100"/>
        <node x="100" y="0" width="50" height="100"/>
      </node>
    </node>
  </expectations>
</test>
