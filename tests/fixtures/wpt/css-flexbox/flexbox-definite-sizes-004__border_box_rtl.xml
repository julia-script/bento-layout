<test name="flexbox-definite-sizes-004__border_box_rtl" use-rounding="true">
  <viewport width="1280px" height="max-content"/>
  <input>
    <div display="block" direction="rtl">
      <div display="flex" direction="rtl" width="100px">
        <div display="flex" direction="rtl" align-items="flex-end" width="100px" max-height="100px">
          <div display="block" direction="rtl" width="100px" max-height="100%">
            <div display="block" direction="rtl" height="9999px"/>
          </div>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="1280" height="100">
      <node x="1180" y="0" width="100" height="100">
        <node x="0" y="0" width="100" height="100">
          <node x="0" y="0" width="100" height="100">
            <node x="0" y="0" width="100" height="9999"/>
          </node>
        </node>
      </node>
    </node>
  </expectations>
</test>
