<test name="flex-minimum-size-single-axis-scroll-container__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="rtl">
      <div display="flex" direction="rtl" align-items="flex-start" width="0px">
        <div display="block" direction="rtl" overflow-x="hidden" overflow-y="clip" scrollbar-width="0">
          <div display="block" direction="rtl" width="100px" height="100px"/>
        </div>
        <div display="block" direction="rtl" overflow-x="clip" overflow-y="hidden" scrollbar-width="0">
          <div display="block" direction="rtl" width="100px" height="100px"/>
        </div>
      </div>
      <div display="flex" direction="rtl" flex-direction="column" align-items="flex-start" height="0px">
        <div display="block" direction="rtl" overflow-x="clip" overflow-y="hidden" scrollbar-width="0">
          <div display="block" direction="rtl" width="100px" height="100px"/>
        </div>
        <div display="block" direction="rtl" overflow-x="hidden" overflow-y="clip" scrollbar-width="0">
          <div display="block" direction="rtl" width="100px" height="100px"/>
        </div>
      </div>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="100" height="100">
      <node x="100" y="0" width="0" height="100">
        <node x="0" y="0" width="0" height="100" scroll_width="100" scroll_height="0">
          <node x="-100" y="0" width="100" height="100"/>
        </node>
        <node x="0" y="0" width="0" height="100" scroll_width="100" scroll_height="0">
          <node x="-100" y="0" width="100" height="100"/>
        </node>
      </node>
      <node x="0" y="100" width="100" height="0">
        <node x="0" y="0" width="100" height="0" scroll_width="0" scroll_height="100">
          <node x="0" y="0" width="100" height="100"/>
        </node>
        <node x="0" y="0" width="100" height="0" scroll_width="0" scroll_height="100">
          <node x="0" y="0" width="100" height="100"/>
        </node>
      </node>
    </node>
  </expectations>
</test>
