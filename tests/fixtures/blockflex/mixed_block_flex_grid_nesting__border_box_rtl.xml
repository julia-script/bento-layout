<test name="mixed_block_flex_grid_nesting__border_box_rtl" use-rounding="true">
  <viewport width="max-content" height="max-content"/>
  <input>
    <div display="block" direction="rtl" width="400px">
      <div display="flex" direction="rtl" height="120px" row-gap="10px" column-gap="10px">
        <div display="grid" direction="rtl" flex-grow="1" row-gap="5px" column-gap="5px" grid-template-rows="1fr 1fr" grid-template-columns="40px 1fr">
          <div direction="rtl"/>
          <div direction="rtl"/>
          <div direction="rtl" grid-column-start="1" grid-column-end="-1"/>
        </div>
        <div direction="rtl" width="100px"/>
      </div>
      <div display="block" direction="rtl" height="30px" margin-top="20px"/>
    </div>
  </input>
  <expectations>
    <node x="0" y="0" width="400" height="170">
      <node x="0" y="0" width="400" height="120">
        <node x="110" y="0" width="290" height="120">
          <node x="250" y="0" width="40" height="58"/>
          <node x="0" y="0" width="245" height="58"/>
          <node x="0" y="63" width="290" height="57"/>
        </node>
        <node x="0" y="0" width="100" height="120"/>
      </node>
      <node x="0" y="140" width="400" height="30"/>
    </node>
  </expectations>
</test>
